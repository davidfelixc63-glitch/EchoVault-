/* SECTION: PUZZLE WORKSHOP — paste at the bottom of attic.css   */
/* ============================================================ */

.puzzle-screen {
  position: fixed;
  inset: 0;
  z-index: 65;
  overflow-y: auto;
  padding: 24px 16px 48px;
  background: radial-gradient(circle at 50% 0%, #1e2a4a, #0b0f1e 70%);
  color: #e2e8f0;
}

/* --- source toggle + pack pills --- */
.puzzle-source-toggle {
  display: flex;
  gap: 8px;
  justify-content: center;
  margin: 16px 0;
}
.puzzle-toggle-btn {
  padding: 8px 18px;
  border-radius: 999px;
  border: 1px solid rgba(96, 165, 250, 0.4);
  background: transparent;
  color: #93c5fd;
  font-weight: 600;
  cursor: pointer;
}
.puzzle-toggle-btn.active {
  background: #60a5fa;
  color: #0b0f1e;
  border-color: #60a5fa;
}

.puzzle-pack-pills {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: 16px;
}
.puzzle-pack-pill {
  padding: 6px 14px;
  border-radius: 999px;
  border: 1px solid rgba(148, 163, 184, 0.3);
  background: rgba(255, 255, 255, 0.05);
  color: #cbd5e1;
  font-size: 0.85rem;
  cursor: pointer;
}
.puzzle-pack-pill.active {
  border-color: #60a5fa;
  color: #60a5fa;
  background: rgba(96, 165, 250, 0.12);
}

/* --- image picker grid --- */
.puzzle-image-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
  gap: 12px;
  max-width: 640px;
  margin: 0 auto;
}
.puzzle-image-thumb {
  aspect-ratio: 1;
  border-radius: 12px;
  background-size: cover;
  background-position: center;
  border: 2px solid transparent;
  cursor: pointer;
}
.puzzle-image-thumb:active,
.puzzle-image-thumb.selected {
  border-color: #60a5fa;
}
.puzzle-empty-note {
  text-align: center;
  color: #94a3b8;
  padding: 32px 16px;
}

/* --- size picker --- */
.puzzle-size-preview {
  display: block;
  width: 160px;
  height: 160px;
  object-fit: cover;
  border-radius: 16px;
  margin: 16px auto 24px;
  border: 1px solid rgba(96, 165, 250, 0.3);
}
.puzzle-size-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  max-width: 360px;
  margin: 0 auto;
}
.puzzle-size-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 18px 8px;
  border-radius: 14px;
  border: 1px solid rgba(96, 165, 250, 0.35);
  background: rgba(255, 255, 255, 0.04);
  color: #e2e8f0;
  cursor: pointer;
}
.puzzle-size-label { font-size: 1.1rem; font-weight: 700; }
.puzzle-size-sub { font-size: 0.8rem; color: #93c5fd; }

/* --- game screen --- */
.puzzle-game-stats {
  display: flex;
  justify-content: center;
  gap: 24px;
  font-variant-numeric: tabular-nums;
  color: #93c5fd;
  margin-bottom: 12px;
}

.puzzle-board-wrap {
  position: relative;
  width: min(92vw, 420px);
  aspect-ratio: 1;
  margin: 0 auto;
}
.puzzle-board {
  display: grid;
  width: 100%;
  height: 100%;
  gap: 3px;
  background: #0b0f1e;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(96, 165, 250, 0.35);
}
.puzzle-tile {
  background-repeat: no-repeat;
  cursor: pointer;
  border-radius: 4px;
  transition: transform 0.08s ease;
}
.puzzle-tile:active { transform: scale(0.96); }
.puzzle-tile-blank { background: transparent; cursor: default; }

.puzzle-peek-overlay {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  border-radius: 12px;
  z-index: 5;
  pointer-events: none;
}

.puzzle-result-banner {
  text-align: center;
  margin-top: 16px;
  font-weight: 700;
  color: #fbbf24;
}

.puzzle-controls {
  display: flex;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 20px;
}
.puzzle-ctrl-btn {
  padding: 10px 14px;
  border-radius: 10px;
  border: 1px solid rgba(148, 163, 184, 0.3);
  background: rgba(255, 255, 255, 0.05);
  color: #e2e8f0;
  font-size: 0.9rem;
  cursor: pointer;
}
.puzzle-ctrl-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}



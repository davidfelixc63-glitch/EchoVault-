.mm-screen {
  position: fixed;
  inset: 0;
  z-index: 65;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 24px 16px 48px;
  box-sizing: border-box;
  background: radial-gradient(circle at 50% 20%, #2b1d0f, #120b05 75%);
}

.mm-hud {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  justify-content: center;
  color: #e8d5b5;
  font-weight: 600;
  font-size: 0.9em;
}
.mm-hud-sprite { font-size: 1.3em; transition: transform 0.3s; }
.mm-canvas {
  background: #1a120a;
  border: 3px solid #8a5a2b;
  border-radius: 8px;
  max-width: 100%;
  touch-action: none;
}
.mm-dpad {
  display: grid;
  grid-template-columns: repeat(3, 48px);
  grid-template-rows: repeat(3, 48px);
  gap: 4px;
}
.mm-dpad-btn {
  background: #3a2612;
  color: #e8d5b5;
  border: 1px solid #8a5a2b;
  border-radius: 8px;
  font-size: 1.1em;
  cursor: pointer;
}
.mm-overlay {
  position: absolute;
  inset: 0;
  background: rgba(10, 6, 2, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: #e8d5b5;
  text-align: center;
  z-index: 20;
}
.mm-levelup-sprite {
  font-size: 3.5em;
  animation: mmEvolvePulse 0.6s ease;
}
@keyframes mmEvolvePulse {
  0% { transform: scale(0.4); opacity: 0; }
  60% { transform: scale(1.25); opacity: 1; }
  100% { transform: scale(1); }
}



.sk-evolve-banner {
  position: absolute;
  top: 20%;
  left: 50%;
  transform: translateX(-50%);
  font-size: 1.4em;
  font-weight: 700;
  color: #fde68a;
  text-shadow: 0 0 12px rgba(253, 230, 138, 0.8);
  z-index: 30;
  pointer-events: none;
}
@keyframes skEvolvePulse {
  0% { transform: translateX(-50%) scale(0.5); opacity: 0; }
  50% { transform: translateX(-50%) scale(1.3); opacity: 1; }
  100% { transform: translateX(-50%) scale(1); opacity: 1; }
}
.sk-evolve-pulse {
  animation: skEvolvePulse 0.6s ease;
}


.vg-screen {
  position: fixed;
  inset: 0;
  z-index: 65;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;

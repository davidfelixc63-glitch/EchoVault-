  cursor: pointer;
}
.em-size-label { font-size: 1.1rem; font-weight: 700; }
.em-size-sub { font-size: 0.8rem; color: #fdba74; }

.em-hud {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-bottom: 14px;
  font-weight: 600;
}

.em-grid {
  display: grid;
  gap: 6px;
  max-width: min(94vw, 480px);
  margin: 0 auto;
  perspective: 800px;
}

.em-card {
  aspect-ratio: 1;
  position: relative;
  cursor: pointer;
}
.em-card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.4s;
}
.em-card.flipped .em-card-inner,
.em-card.matched .em-card-inner {
  transform: rotateY(180deg);
}
.em-card-face {
  position: absolute;
  inset: 0;
  backface-visibility: hidden;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.em-card-back {
  background: linear-gradient(135deg, #fb923c, #ef4444);
  font-size: 1.4rem;
}
.em-card-front {
  transform: rotateY(180deg);
  background: #1a0a05;
  border: 1px solid rgba(251, 146, 60, 0.4);
}
.em-card-front img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.em-card-front-icon {
  font-size: 1.6rem;
}
.em-card-front-label {
  font-size: 0.6rem;
  color: #fdba74;
  text-align: center;
  padding: 0 2px;
}
.em-card.matched .em-card-front {
  border-color: #4ade80;
  box-shadow: 0 0 10px rgba(74, 222, 128, 0.6);
}

/* ============================================================ */
/* SECTION: MEMORY WHACK-A-MOLE — paste at the bottom of attic.css */
/* ============================================================ */

.wm-target-toggle {
  display: flex;
  gap: 8px;
  justify-content: center;
  margin: 20px 0 12px;
}
.wm-category-select {
  display: block;
  margin: 0 auto 16px;
  padding: 8px 14px;
  border-radius: 10px;
  background: #1a0a05;
  color: #fef3e2;
  border: 1px solid rgba(251, 146, 60, 0.4);
}
.wm-start-btn {
  display: block;
  margin: 12px auto 0;
}

.wm-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  max-width: min(90vw, 360px);
  margin: 0 auto;
}
.wm-hole {
  aspect-ratio: 1;
  border-radius: 14px;
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid rgba(251, 146, 60, 0.25);
  position: relative;
  overflow: hidden;
}
.wm-card {
  position: absolute;
  inset: 4px;
  border-radius: 10px;
  background: #1a0a05;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  cursor: pointer;
  transform: scale(0);
  transition: transform 0.15s ease-out;
}
.wm-card.wm-visible { transform: scale(1); }
.wm-card img { width: 100%; height: 100%; object-fit: cover; }
.wm-card-label {
  font-size: 0.65rem;
  padding: 2px;
  text-align: center;
  color: #fef3e2;
}
.wm-card.wm-target { box-shadow: 0 0 0 2px #4ade80 inset; }


/* ============================================================ */
/* SECTION: STREAK KEEPER — paste at the bottom of attic.css     */
/* ============================================================ */

.sk-game-wrap {
  position: relative;
  width: min(94vw, 480px);
  height: 260px;
  margin: 12px auto 0;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid rgba(251, 146, 60, 0.35);
  background: linear-gradient(180deg, #2a1408, #0e0705);
}
.sk-canvas {
  width: 100%;
  height: 100%;
  display: block;
}


/* ============================================================ */
/* SECTION: DEV MUSEUM — paste at the bottom of attic.css        */
/* ============================================================ */

.museum-screen {
  position: fixed;
  inset: 0;
  z-index: 65;
  overflow-y: auto;
  padding: 24px 16px 64px;
  background: radial-gradient(circle at 50% 0%, #1f2937, #0b0f14 70%);
  color: #e5e7eb;
}

.museum-section {
  max-width: 560px;
  margin: 28px auto 0;
}
.museum-section-title {
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 4px;
}
.museum-section-sub {
  font-size: 0.8rem;
  color: #9ca3af;
  margin-bottom: 10px;
}

/* --- timeline --- */
.museum-timeline {
  border-left: 2px solid rgba(96, 165, 250, 0.4);
  padding-left: 16px;
  margin-top: 12px;
}
.museum-timeline-item {
  position: relative;
  padding-bottom: 18px;
}
.museum-timeline-item::before {
  content: "";
  position: absolute;
  left: -21px;
  top: 4px;
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: #60a5fa;
}
.museum-timeline-phase {
  font-weight: 700;
  color: #93c5fd;
}
.museum-timeline-desc {
  font-size: 0.85rem;
  color: #d1d5db;
}

/* --- stats --- */
.museum-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-top: 12px;
}
.museum-stat-card {
  padding: 14px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(96, 165, 250, 0.25);
  text-align: center;
}
.museum-stat-value {
  font-size: 1.4rem;
  font-weight: 800;
  color: #60a5fa;
}
.museum-stat-label {
  font-size: 0.75rem;
  color: #9ca3af;
}

/* --- bug wall --- */
.museum-bug-wall {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 12px;
}
.museum-bug-item {
  padding: 10px 14px;
  border-radius: 10px;
  background: rgba(239, 68, 68, 0.08);
  border-left: 3px solid #ef4444;
  font-size: 0.82rem;
  color: #d1d5db;
}
.museum-bug-item strong { color: #fca5a5; }

/* --- dev secrets --- */
.museum-secrets-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 10px;
  margin-top: 4px;
}
.museum-secret-card {
  padding: 16px 10px;
  border-radius: 12px;
  background: rgba(167, 139, 250, 0.08);
  border: 1px solid rgba(167, 139, 250, 0.3);
  text-align: center;
  cursor: pointer;
  font-size: 0.8rem;
  min-height: 70px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.museum-secret-card.revealed {
  background: rgba(167, 139, 250, 0.18);
  cursor: default;
}
.museum-secret-locked-label {
  color: #a78bfa;
  font-weight: 600;
}

/* --- tech plaque --- */
.museum-tech-plaque {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}
.museum-tech-chip {
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(96, 165, 250, 0.12);
  border: 1px solid rgba(96, 165, 250, 0.35);
  color: #93c5fd;
  font-size: 0.8rem;
  font-weight: 600;
}

.museum-future-note {
  font-size: 0.85rem;
  color: #9ca3af;
  margin-top: 8px;
}


/* ============================================================ */
/* SECTION: ATTIC SOUNDTRACK SYSTEM — paste at the bottom of attic.css */
/* ============================================================ */

.attic-music-control-bar {
  position: fixed;
  bottom: 16px;
  right: 16px;
  z-index: 70;
  display: none; /* only shown while body.attic-active — see rule below */
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.15);
}
body.attic-active .attic-music-control-bar {
  display: flex;
}
.attic-music-ctrl-btn {
  width: 32px;
  height: 32px;
  border-radius: 999px;
  border: none;
  background: rgba(255, 255, 255, 0.08);
  color: #e2e8f0;
  font-size: 0.9rem;
  cursor: pointer;
  flex-shrink: 0;
}
.attic-music-volume-slider {
  width: 70px;
  accent-color: #fbbf24;
}

.attic-hub-disc-row {
  display: flex;
  gap: 10px;
  justify-content: center;
  margin: 16px 0 20px;
}

.attic-disc {
  width: 34px;
  height: 34px;
  border-radius: 999px;
  background: radial-gradient(circle at center, #1a1a1a 0%, #1a1a1a 28%, #444 30%, #222 55%, #111 100%);
  border: 2px solid rgba(255, 255, 255, 0.12);
  cursor: pointer;
  position: relative;
}
.attic-disc::after {
  content: "";
  position: absolute;
  inset: 0;
  margin: auto;
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: #666;
}
.attic-disc.attic-disc-active {
  border-color: #fbbf24;
  box-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
  animation: atticDiscSpin 3s linear infinite;
}
@keyframes atticDiscSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}



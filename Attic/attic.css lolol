  text-align: center;
  margin: 0;
}
.attic-library-fact-source {
  color: rgba(253, 230, 138, 0.4);
  font-size: 0.75rem;
  text-align: center;
  margin-top: 16px;
}

.attic-library-controls {
  max-width: 480px;
  margin: 20px auto 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
}

.attic-library-nav-btn {
  background: rgba(39, 39, 42, 0.8);
  border: 1px solid rgba(120, 53, 15, 0.4);
  color: #fde68a;
  width: 44px;
  height: 44px;
  border-radius: 999px;
  font-size: 1.3rem;
  cursor: pointer;
}

.attic-library-whoa-btn {
  background: #f59e0b;
  color: #000;
  font-weight: 600;
  border: none;
  border-radius: 999px;
  padding: 12px 22px;
  font-size: 0.9rem;
  cursor: pointer;
  transition: background 0.15s ease, transform 0.1s ease;
}
.attic-library-whoa-btn.attic-library-whoa-active {
  background: #fde047;
  transform: scale(1.05);
}

.attic-library-favorites-list {
  max-width: 480px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.attic-library-favorite-item {
  background: linear-gradient(to bottom, #18181b, #1c130d);
  border: 1px solid rgba(146, 64, 14, 0.4);
  border-radius: 16px;
  padding: 16px 18px;
}
.attic-library-favorite-text {
  color: #fffbeb;
  font-size: 0.9rem;
  line-height: 1.5;
  margin: 0 0 10px;
}
.attic-library-favorite-actions {
  display: flex;
  gap: 10px;
}
.attic-library-favorite-share-btn,
.attic-library-favorite-remove-btn {
  background: transparent;
  border: 1px solid rgba(253, 230, 138, 0.25);
  color: rgba(253, 230, 138, 0.7);
  border-radius: 999px;
  padding: 6px 14px;
  font-size: 0.75rem;
  cursor: pointer;
}

.attic-library-share-canvas {
  width: 100%;
  max-width: 320px;
  aspect-ratio: 1 / 1;
  border-radius: 16px;
  margin: 0 auto 16px;
  display: block;
}


.riddle-category-grid { display: flex; flex-direction: column; gap: 12px; padding: 16px; }
.riddle-category-card {
  background: rgba(99, 102, 241, 0.08); border: 1px solid rgba(99, 102, 241, 0.3);
  border-radius: 14px; padding: 16px; display: flex; justify-content: space-between;
  align-items: center; cursor: pointer; transition: transform 0.15s;
}
.riddle-category-card:active { transform: scale(0.97); }
.riddle-category-card.locked { opacity: 0.4; pointer-events: none; }
.riddle-category-progress { font-size: 0.8rem; color: #a5b4fc; }

.riddle-card {
  background: rgba(30, 27, 20, 0.6); border: 1px solid rgba(99, 102, 241, 0.25);
  border-radius: 16px; padding: 20px; margin: 16px;
}
.riddle-story { font-style: italic; color: #d4cbb8; margin-bottom: 12px; line-height: 1.5; }
.riddle-prompt { font-size: 1.1rem; font-weight: 600; margin-bottom: 16px; }
.riddle-hints { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
.riddle-hint-text { font-size: 0.9rem; color: #c4b5fd; background: rgba(99,102,241,0.1); padding: 8px 12px; border-radius: 10px; }
.riddle-input-row { display: flex; gap: 8px; }
.riddle-input-row input {
  flex: 1; padding: 10px 14px; border-radius: 10px; border: 1px solid rgba(99,102,241,0.3);
  background: rgba(0,0,0,0.3); color: #fff;
}
.riddle-input-row button { padding: 10px 16px; border-radius: 10px; background: #6366f1; color: #fff; border: none; }
.riddle-feedback { margin-top: 10px; font-size: 0.9rem; min-height: 1.2em; }
.riddle-feedback.correct { color: #4ade80; }
.riddle-feedback.wrong { color: #f87171; }
.riddle-action-row { display: flex; gap: 10px; margin-top: 14px; }
.riddle-hint-btn, .riddle-giveup-btn, .riddle-next-btn {
  padding: 8px 14px; border-radius: 10px; border: 1px solid rgba(99,102,241,0.4);
  background: transparent; color: #c4b5fd; font-size: 0.85rem;
}
.riddle-next-btn { background: #6366f1; color: #fff; }

@keyframes riddleFlicker {
  0%, 100% { opacity: 0.5; transform: translateY(0) scale(1); }
  50% { opacity: 0.9; transform: translateY(-4px) scale(1.08); }
}
@keyframes riddleFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

#riddleDenCategoryScreen, #riddleCardScreen {
  background:
    radial-gradient(circle at 20% 15%, rgba(167,139,250,0.14), transparent 40%),
    radial-gradient(circle at 80% 85%, rgba(99,102,241,0.12), transparent 45%),
    radial-gradient(circle at 50% 0%, #201229 0%, #0a0710 70%);
}

#riddleDenCategoryScreen .attic-room-title,
#riddleCardScreen .riddle-progress-label {
  text-shadow: 0 0 14px rgba(167,139,250,0.45);
}
.riddle-mystery-decor { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
.riddle-mystery-decor span {
  position: absolute; opacity: 0.55;
  filter: drop-shadow(0 0 6px rgba(167,139,250,0.5));
}
.riddle-mystery-decor span:nth-child(1) { top: 8%;  left: 8%;  font-size: 1.4rem; animation: riddleFlicker 4s ease-in-out infinite; }
.riddle-mystery-decor span:nth-child(2) { top: 14%; right: 10%; font-size: 1.1rem; animation: riddleFloat 6s ease-in-out infinite; }
.riddle-mystery-decor span:nth-child(3) { bottom: 14%; left: 12%; font-size: 1.2rem; animation: riddleFloat 5s ease-in-out infinite reverse; }
.riddle-mystery-decor span:nth-child(4) { bottom: 10%; right: 14%; font-size: 1rem;  animation: riddleFlicker 3.5s ease-in-out infinite; }
#riddleCategoryList, .riddle-card { position: relative; z-index: 1; }
.riddle-card::before {
  content: "🔮";
  position: absolute; top: -14px; left: 50%; transform: translateX(-50%);
  font-size: 1.3rem; background: #150f24; padding: 2px 10px; border-radius: 50%;
  border: 1px solid rgba(167,139,250,0.35);
}
.riddle-prompt { font-family: Georgia, 'Times New Roman', serif; letter-spacing: 0.3px; }



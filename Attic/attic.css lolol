/*
  ATTIC.CSS — styles specific to the Attic feature only.
  Linked from the main index.html <head> via:
    <link rel="stylesheet" href="Attic/attic.css">

  IMPORTANT: this file uses plain hand-written CSS, NOT Tailwind utilities,
  for anything inside the fetch()-injected fragment (attic.html). Tailwind's
  CDN script scans the page once on load and does not reliably re-scan content
  injected later via fetch() + innerHTML — so Tailwind classes in attic.html
  would render unstyled. If you ever see Attic markup showing up unstyled,
  this is the first thing to check.

  SECTIONS IN THIS FILE (in order):
    1. UTILITY (hidden toggle)
    2. ATTIC MODE                      — hides main EchoVault nav, locks scroll
    3. MODAL + LAYOUT COMPONENTS       — backdrop, card, headings, inputs, button
    4. FIRST-ENTRY REVEAL ANIMATIONS   — door creak, light flood, dust rise, quick door beat
    5. HUB                             — full-screen room grid, doors, header, back button
    (Future room-specific styles will be appended below as new sections,
    each clearly labeled the same way — paste new room CSS at the bottom.)
*/

/* ============================================================ */
/* SECTION 1: UTILITY                                            */
/* ============================================================ */
.attic-hidden { display: none !important; }
#atticRoot .hidden { display: none !important; }

/* ============================================================ */
/* SECTION 2: ATTIC MODE                                         */
/* ============================================================ */
/* Applied to <body> for the entire time the user is "inside" the Attic —
   from the moment the door is tapped on Showcase until they tap
   "Back to EchoVault" on the hub. Hides the main site's nav (logo,
   hamburger, links) and locks background scroll, so the Attic reads as
   a separate space with exactly two connection points: the Showcase
   door (in) and the hub's back button (out). */
body.attic-active nav { display: none !important; }
body.attic-active { overflow: hidden; }

/* ============================================================ */
/* SECTION 3: MODAL + LAYOUT COMPONENTS                          */
/* ============================================================ */
.attic-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 70;
  padding: 16px;
}

.attic-modal-card {
  background: linear-gradient(to bottom, #18181b, #1c130d);
  border: 1px solid rgba(146, 64, 14, 0.4);
  border-radius: 24px;
  padding: 32px;
  width: 100%;
  max-width: 28rem;
  text-align: center;
  box-shadow: 0 0 60px rgba(217, 119, 6, 0.15);
  box-sizing: border-box;
}

.attic-emoji-lg { font-size: 3rem; margin-bottom: 12px; }
.attic-emoji-md { font-size: 2.25rem; margin-bottom: 8px; }

.attic-heading {
  color: #fde68a;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 1.875rem;
  margin: 0;
}
.attic-heading-sm { font-size: 1.5rem; }

.attic-body-text {
  color: rgba(253, 230, 138, 0.7);
  margin-top: 12px;
  font-size: 0.875rem;
  line-height: 1.6;
}

.attic-subtext {
  color: rgba(253, 230, 138, 0.5);
  margin-top: 16px;
  font-size: 0.75rem;
  line-height: 1.6;
}
.attic-subtext-center { color: rgba(253, 230, 138, 0.6); margin-top: 8px; font-size: 0.875rem; }

.attic-label { color: rgba(253, 230, 138, 0.6); font-size: 0.75rem; margin-bottom: 8px; }

.attic-trigger-block { margin-top: 20px; text-align: left; }

.attic-input {
  width: 100%;
  background: rgba(39, 39, 42, 0.8);
  border: 1px solid rgba(120, 53, 15, 0.3);
  border-radius: 12px;
  padding: 12px;
  color: #fffbeb;
  font-size: 0.9rem;
  margin-top: 12px;
  box-sizing: border-box;
}
.attic-input::placeholder { color: rgba(253, 230, 138, 0.2); }
.attic-input-center { text-align: center; }

.attic-error { color: #f87171; font-size: 0.75rem; margin-top: 12px; }

.attic-btn-primary {
  width: 100%;
  margin-top: 20px;
  background: #f59e0b;
  color: #000;
  font-weight: 600;
  border: none;
  border-radius: 12px;
  padding: 12px;
  font-size: 1rem;
  cursor: pointer;
  transition: background 0.15s ease;
}
.attic-btn-primary:hover { background: #fbbf24; }

/* ============================================================ */
/* SECTION 4: FIRST-ENTRY REVEAL ANIMATIONS                      */
/* ============================================================ */
.attic-reveal-overlay {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.attic-reveal-light {
  position: absolute;
  inset: 0;
  opacity: 0;
}

.attic-reveal-dust {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.attic-reveal-door {
  font-size: 4.5rem;
  opacity: 0;
  position: relative;
  z-index: 10;
}

@keyframes atticDoorCreak {
  0% { opacity: 0; transform: scale(0.9) rotate(0deg); }
  15% { opacity: 1; transform: scale(0.95) rotate(0deg); }
  40% { transform: scale(1) rotate(-8deg); }
  60% { transform: scale(1) rotate(6deg); }
  80% { transform: scale(1.05) rotate(-3deg); }
  100% { opacity: 0; transform: scale(1.4) rotate(0deg); }
}
.attic-door-creak { animation: atticDoorCreak 1.6s ease-in-out forwards; }

/* Quick beat played ON the Showcase page door itself, right before Attic
   mode kicks in — a small confirmation, not the full cinematic reveal. */
@keyframes atticDoorQuickOpen {
  0% { transform: scale(1) rotate(0deg); }
  50% { transform: scale(1.12) rotate(-6deg); }
  100% { transform: scale(1) rotate(0deg); }
}
.attic-door-quick-open { animation: atticDoorQuickOpen 0.7s ease-in-out; }

@keyframes atticLightFlood {
  0% { opacity: 0; }
  100% { opacity: 1; }
}
.attic-light-flood {
  background: radial-gradient(circle at 50% 60%, rgba(217,119,6,0.55) 0%, rgba(120,53,15,0.35) 35%, rgba(0,0,0,0.9) 75%);
  animation: atticLightFlood 1.8s ease-out forwards;
}

@keyframes atticDustRise {
  0% { transform: translateY(0) scale(1); opacity: 0; }
  20% { opacity: 0.9; }
  100% { transform: translateY(-120px) scale(0.4); opacity: 0; }
}
.attic-dust-mote {
  position: absolute;
  width: 3px; height: 3px;
  background: rgba(252, 211, 77, 0.7);
  border-radius: 9999px;
  animation: atticDustRise 3s ease-out forwards;
}

/* ============================================================ */
/* SECTION 5: HUB                                                */
/* ============================================================ */
.attic-hub-screen {
  position: fixed;
  inset: 0;
  z-index: 65;
  background: radial-gradient(circle at 50% 0%, #2a1a0f 0%, #0a0705 70%);
  overflow-y: auto;
  padding: 32px 20px 60px;
  box-sizing: border-box;
}

.attic-room-title {
  color: #fde68a;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 2rem;
  text-align: center;
  margin: 0 0 20px;
}

.attic-back-btn {
  display: block;
  margin: 0 0 20px 0;
  background: transparent;
  border: 1px solid rgba(253, 230, 138, 0.25);
  color: rgba(253, 230, 138, 0.7);
  border-radius: 999px;
  padding: 8px 16px;
  font-size: 0.8rem;
  cursor: pointer;
  transition: border-color 0.15s ease, color 0.15s ease;
}
.attic-back-btn:hover {
  border-color: rgba(253, 230, 138, 0.6);
  color: #fde68a;
}

.attic-hub-header {
  text-align: center;
  margin-bottom: 32px;
}
.attic-hub-title {
  color: #fde68a;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 2.25rem;
  margin: 0;
}
.attic-hub-subtitle {
  color: rgba(253, 230, 138, 0.5);
  font-size: 0.875rem;
  margin-top: 6px;
}

.attic-hub-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  max-width: 480px;
  margin: 0 auto;
}

.attic-room-door {
  background: linear-gradient(to bottom, #241a12, #150e08);
  border: 1px solid color-mix(in srgb, var(--room-color) 35%, transparent);
  border-radius: 18px;
  padding: 24px 12px;
  text-align: center;
  cursor: pointer;
  transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}
.attic-room-door:hover,
.attic-room-door:active {
  transform: translateY(-3px);
  border-color: var(--room-color);
  box-shadow: 0 8px 24px color-mix(in srgb, var(--room-color) 25%, transparent);
}

.attic-room-icon {
  font-size: 2.25rem;
  margin-bottom: 10px;
  filter: drop-shadow(0 0 8px color-mix(in srgb, var(--room-color) 60%, transparent));
}

.attic-room-label {
  color: #fde68a;
  font-size: 0.8rem;
  font-weight: 600;
}


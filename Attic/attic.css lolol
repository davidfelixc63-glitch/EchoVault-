/* SECTION: GAME ARCADE — paste at the bottom of attic.css       */
/* ============================================================ */

.arcade-screen {
  position: fixed;
  inset: 0;
  z-index: 65;
  overflow-y: auto;
  padding: 24px 16px 48px;
  background: radial-gradient(circle at 50% 0%, #3a1e12, #0e0705 70%);
  color: #fef3e2;
}

/* --- hub grid --- */
.arcade-game-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 14px;
  max-width: 560px;
  margin: 20px auto 0;
}
.arcade-game-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 22px 12px;
  border-radius: 16px;
  border: 1px solid rgba(251, 146, 60, 0.35);
  background: rgba(255, 255, 255, 0.04);
  cursor: pointer;
  text-align: center;
}
.arcade-game-card:active { transform: scale(0.97); }
.arcade-game-icon { font-size: 2rem; }
.arcade-game-name { font-weight: 700; }
.arcade-game-desc { font-size: 0.78rem; color: #fdba74; }
.arcade-locked {
  opacity: 0.45;
  cursor: default;
}
.arcade-locked:active { transform: none; }

/* --- Memory Falls HUD --- */
.mf-hud {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-bottom: 8px;
  font-weight: 600;
}
.mf-hud-item { color: #fdba74; }

.mf-speed-meter-track {
  width: min(92vw, 420px);
  height: 6px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.1);
  margin: 0 auto 16px;
  overflow: hidden;
}
.mf-speed-meter-fill {
  height: 100%;
  width: 10%;
  background: linear-gradient(90deg, #fbbf24, #ef4444);
  transition: width 0.4s ease;
}

/* --- game area + falling words --- */
.mf-game-area {
  position: relative;
  width: min(92vw, 420px);
  height: 60vh;
  max-height: 520px;
  margin: 0 auto;
  border-radius: 16px;
  border: 1px solid rgba(251, 146, 60, 0.35);
  background: rgba(0, 0, 0, 0.35);
  overflow: hidden;
}
.mf-hidden-input {
  position: absolute;
  opacity: 0;
  height: 1px;
  width: 1px;
  pointer-events: none;
  top: 0;
  left: 0;
}

.mf-word {
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  font-size: 1.3rem;
  font-weight: 700;
  letter-spacing: 1px;
  white-space: nowrap;
  transition: top linear;
}
.mf-letter { color: #fef3e2; }
.mf-letter-typed { color: #4ade80; opacity: 0.5; }
.mf-word-locked .mf-letter { color: #fbbf24; }

.mf-explode {
  animation: mfExplode 0.3s ease-out forwards;
}
@keyframes mfExplode {
  0% { transform: translateX(-50%) scale(1); opacity: 1; }
  100% { transform: translateX(-50%) scale(1.8); opacity: 0; }
}

/* --- overlays --- */
.mf-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  background: rgba(14, 7, 5, 0.9);
  text-align: center;
  padding: 24px;
  z-index: 5;
}
.mf-primary-btn {
  padding: 12px 28px;
  border-radius: 12px;
  border: none;
  background: linear-gradient(135deg, #fb923c, #ef4444);
  color: #1a0a05;
  font-weight: 700;
  cursor: pointer;
}
.mf-secondary-btn {
  padding: 10px 22px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: transparent;
  color: #fef3e2;
  cursor: pointer;
}

.mf-level-up-banner {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 1.4rem;
  font-weight: 800;
  color: #fbbf24;
  text-shadow: 0 0 12px rgba(251, 191, 36, 0.8);
  z-index: 4;
  animation: mfLevelUpPulse 1.2s ease-out forwards;
  pointer-events: none;
}
@keyframes mfLevelUpPulse {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.8); }
  20% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
  80% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(1); }
}



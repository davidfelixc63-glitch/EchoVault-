.attic-library-category-label { color: #fde68a; font-size: 0.8rem; font-weight: 600; }
.attic-library-category-sub { color: rgba(253, 230, 138, 0.4); font-size: 0.65rem; margin-top: 4px; }

.attic-library-card-stage {
  max-width: 480px;
  margin: 0 auto;
  padding: 0 4px;
}

.attic-library-card {
  background: linear-gradient(to bottom, #18181b, #1c130d);

  text-align: center;
  max-width: 380px;
  margin: 0 auto;
  padding: 0 20px 32px;
  line-height: 1.6;
}
.time-chamber-doors { display: flex; flex-direction: column; gap: 18px; max-width: 420px; margin: 0 auto; padding: 0 20px; }
.time-chamber-door {
  background: linear-gradient(to bottom, #18181b, #140f1c);
  border: 1px solid rgba(124, 58, 237, 0.3);
  border-radius: 24px;
  padding: 32px 24px;
  text-align: center;
  cursor: pointer;
  box-shadow: 0 0 50px rgba(124, 58, 237, 0.1);
  transition: transform 0.2s, box-shadow 0.2s;
}
.time-chamber-door:active { transform: scale(0.98); box-shadow: 0 0 60px rgba(124, 58, 237, 0.2); }
.door-icon { display: block; font-size: 2.5rem; margin-bottom: 12px; opacity: 0.9; }

      <div id="buryResurfacePhotoWrap" class="bury-resurface-photo-wrap attic-hidden">
        <img id="buryResurfacePhoto" class="bury-resurface-photo" alt="">
      </div>
      <div id="buryResurfaceVoiceWrap" class="bury-resurface-voice-wrap attic-hidden">
        <audio id="buryResurfaceVoice" class="bury-resurface-voice" controls></audio>
      </div>
    </div>

    <div class="bury-resurface-actions">
      <button type="button" class="bury-action-btn bury-action-keep" onclick="handleBuryKeepInLight()">
        Keep in the light
        <span>Returns to your normal memories</span>
      </button>
      <button type="button" class="bury-action-btn bury-action-sit" onclick="handleBurySitWithIt()">
        Sit with it
        <span>Close for now — find it under Returned</span>
      </button>
      <button type="button" class="bury-action-btn bury-action-release" onclick="handleBuryRelease()">
        Release
        <span>Deletes this memory for good</span>
      </button>
    </div>
  </div>
</div>

<!-- Brief "laying down" beat after confirming a bury -->
<div id="buryLayDownOverlay" class="attic-hidden bury-laydown-overlay">
  <div class="bury-laydown-dim"></div>
  <div class="bury-laydown-stage">
    <div class="bury-laydown-glyph">🪦</div>
    <p class="bury-laydown-text">Set down for now</p>
    <p class="bury-laydown-sub" id="buryLayDownWhen"></p>
  </div>
</div>


<!-- Floating music controls — a fixed sibling of every Attic screen, always visible while attic-active -->
<div id="atticMusicControlBar" class="attic-music-control-bar">
  <button id="atticMusicPlayPauseBtn" class="attic-music-ctrl-btn" onclick="toggleAtticMusicPlayPause()">⏸️</button>
  <button id="atticMusicMuteBtn" class="attic-music-ctrl-btn" onclick="toggleAtticMusicMute()">🔊</button>
  <input id="atticMusicVolumeSlider" class="attic-music-volume-slider" type="range" min="0" max="100" value="45" oninput="setAtticMusicVolume(this.value)">
</div>

